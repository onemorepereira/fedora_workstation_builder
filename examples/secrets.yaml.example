---
# Copy to secrets.yaml (git-ignored), fill in your real keys, then encrypt it:
#
#   cp examples/secrets.yaml.example secrets.yaml
#   ansible-vault encrypt secrets.yaml
#
# and pass it at run time:
#
#   ansible-playbook play_local.yaml -e @my-profile.yaml -e @secrets.yaml --ask-vault-pass
#
# NEVER commit the real secrets.yaml.

# Private keys written to /home/<sys_user>/.ssh/<key_name> (mode 0600)
ssh_keypairs:
  personal:
    key_name: id_ed25519
    key_value: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      REPLACE-ME
      -----END OPENSSH PRIVATE KEY-----
